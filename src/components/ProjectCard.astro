---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { Project } from '../data/site';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const isRepo = project.href.startsWith('https://github.com/');
---

<li class="card">
  <a href={project.href}>
    <div class="preview">
      {
        project.image && (
          <Image
            src={project.image}
            alt=""
            widths={[360, 720]}
            sizes="(max-width: 40rem) 100vw, 360px"
            loading="lazy"
          />
        )
      }
      {
        project.embed && (
          <iframe
              src={project.embed}
              title={`Live preview of ${project.title}`}
              loading="lazy"
              tabindex="-1"
              aria-hidden="true"
              referrerpolicy="no-referrer"
            />
        )
      }
    </div>
    <div class="meta">
      <h3>
        {project.title}
        <Icon name={isRepo ? 'mdi:github' : 'lucide:arrow-up-right'} aria-hidden="true" />
      </h3>
      <p>
        {project.category}
        {project.embed && <span class="live">Live</span>}
      </p>
    </div>
  </a>
</li>

<style>
  .card a {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }

  .card a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .preview {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--accent-soft);
    border-bottom: 1px solid var(--border);
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  /* Render the site at 4x the card size, then shrink it, so it lays out like a desktop page. */
  iframe {
    position: absolute;
    inset: 0;
    width: 400%;
    height: 400%;
    border: 0;
    transform: scale(0.25);
    transform-origin: 0 0;
    pointer-events: none;
    background: transparent;
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: 0.5rem;
    color: var(--accent);
    font-weight: 500;
  }

  .live::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ef4444;
  }

  .meta {
    padding: 0.875rem 1rem 1rem;
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 1rem;
    font-weight: 600;
  }

  h3 svg {
    width: 1rem;
    height: 1rem;
    color: var(--muted);
  }

  .card a:hover h3 svg {
    color: var(--accent);
  }

  p {
    margin: 0.2rem 0 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .card a {
      transition: none;
    }

    .card a:hover {
      transform: none;
    }
  }
</style>
