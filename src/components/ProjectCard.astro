---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { Project } from '../data/site';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<li class="card">
  <a href={project.href}>
    <Image
      src={project.image}
      alt=""
      widths={[360, 720]}
      sizes="(max-width: 40rem) 100vw, 360px"
      loading="lazy"
    />
    <div class="meta">
      <h3>
        {project.title}
        <Icon name="lucide:arrow-up-right" aria-hidden="true" />
      </h3>
      <p>{project.category}</p>
    </div>
  </a>
</li>

<style>
  .card a {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }

  .card a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border-bottom: 1px solid var(--border);
  }

  .meta {
    padding: 0.875rem 1rem 1rem;
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 1rem;
    font-weight: 600;
  }

  h3 svg {
    width: 1rem;
    height: 1rem;
    color: var(--muted);
  }

  .card a:hover h3 svg {
    color: var(--accent);
  }

  p {
    margin: 0.2rem 0 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .card a {
      transition: none;
    }

    .card a:hover {
      transform: none;
    }
  }
</style>
